{
  "name": "my-machine-build",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "agent:lint:fix": "vp check --fix",
    "agent:test:unit": "vp test run --reporter=tap-flat --no-color",
    "agent:verify:inner": "vpr typecheck && vp lint",
    "agent:verify:unit": "vpr agent:verify:inner && vpr agent:test:unit",
    "check:fast": "vpr typecheck && vp lint && vpr agent:test:unit",
    "test:unit": "vp test run",
    "typecheck": "tsc --noEmit --pretty false",
    "verify": "vp check && vpr typecheck && vp test run"
  },
  "dependencies": {
    "defuddle": "0.19.6",
    "linkedom": "0.18.15",
    "turndown": "7.2.5",
    "turndown-plugin-gfm": "1.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/turndown": "5.0.6",
    "typescript": "7.0.2",
    "vite-plus": "1.6.0"
  },
  "engines": {
    "node": "26.13.1"
  }
}
