#compdef webread

_webread() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-s --selector)'{-s,--selector}'[Extract specific DOM element using CSS selector]:selector:_default' \
    '(-l --llms)'{-l,--llms}'[Probe and fetch /llms-full.txt or /llms.txt from site domain]' \
    '(-r --raw)'{-r,--raw}'[Fetch raw content without Markdown conversion]' \
    '(-o --output)'{-o,--output}'[Save output directly to a file]:file:_files' \
    '--jina[Use external Jina Reader (r.jina.ai) as fallback]' \
    '--external[Use external Jina Reader (r.jina.ai) as fallback]' \
    '--no-enclosure[Omit the <UNTRUSTED_EXTERNAL_WEB_CONTENT> security barrier]' \
    '--max-chars[Maximum characters before safety truncation (default: 64000)]:chars:_default' \
    '(-h --help)'{-h,--help}'[Show help message and exit]' \
    '*:url:_urls'
}

_webread "$@"
